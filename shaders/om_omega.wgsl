fn seg_dist(p: vec2<f32>, a: vec2<f32>, b: vec2<f32>) -> f32 {
    let pa = p - a; let ba = b - a;
    let h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
    return length(pa - ba * h);
}

// Signed distance to OM outline (negative inside, via even-odd ray crossing).
fn sd_om(p: vec2<f32>) -> f32 {
    var d = 1e9; var cross = 0;
    for (var i = 0u; i < OM_N; i = i + 1u) {
        let s = OM[i]; let a = s.xy; let b = s.zw;
        d = min(d, seg_dist(p, a, b));
        if ((a.y > p.y) != (b.y > p.y)) {
            let xint = a.x + (p.y - a.y) / (b.y - a.y) * (b.x - a.x);
            if (p.x < xint) { cross = cross + 1; }
        }
    }
    return select(d, -d, (cross & 1) == 1);
}

fn sd_og(p: vec2<f32>) -> f32 {
    var d = 1e9; var cross = 0;
    for (var i = 0u; i < OG_N; i = i + 1u) {
        let s = OG[i]; let a = s.xy; let b = s.zw;
        d = min(d, seg_dist(p, a, b));
        if ((a.y > p.y) != (b.y > p.y)) {
            let xint = a.x + (p.y - a.y) / (b.y - a.y) * (b.x - a.x);
            if (p.x < xint) { cross = cross + 1; }
        }
    }
    return select(d, -d, (cross & 1) == 1);
}

@fragment
fn fs_main(in: VertexOutput) -> @location(0) vec4<f32> {
    let aspect = u.resolution.x / u.resolution.y;
    var p = in.uv - 0.5;
    if (aspect >= 1.0) { p.x = p.x * aspect; } else { p.y = p.y / aspect; }
    p = p * 2.0;   // glyph data is y-up and matches the offscreen render

    // Loop t: 0->1->0 smooth, with brief holds on each symbol. beat quickens it.
    let period = 8.0;
    let ph = fract(u.time / period);
    let pp = (1.0 - cos(6.2831853 * ph)) * 0.5;         // 0..1..0
    var t = clamp((pp - 0.12) / 0.76, 0.0, 1.0);
    t = t * t * (3.0 - 2.0 * t);

    // Blend the two signed fields. Both glyphs fit within radius ~0.75, so for
    // pixels well outside that we skip the per-segment loops entirely (the field
    // is a large positive value there — no fill, negligible glow).
    var field: f32;
    if (length(p) > 1.25) {
        field = length(p) - 0.7;
    } else {
        field = mix(sd_om(p), sd_og(p), t);
    }

    // ---- polished silver shading (field is in normalized units) ----
    let px = 2.0 / u.resolution.y;                       // ~1 pixel in p-space
    let fill = clamp(0.5 - field / (px * 1.6), 0.0, 1.0);
    let core = clamp(-field / 0.14, 0.0, 1.0);
    let sil_a = vec3<f32>(0.55, 0.60, 0.68);
    let sil_b = vec3<f32>(0.93, 0.96, 1.00);
    var col = mix(sil_a, sil_b, core);
    let sheen = 0.72 + 0.55 * (0.5 + p.y * 0.5);   // top-lit metallic
    col = col * clamp(sheen, 0.4, 1.4);
    let glow = exp(-max(field, 0.0) / 0.09);
    let glowc = vec3<f32>(0.42, 0.52, 0.68) * glow * (0.85 + u.amplitude * 0.5);
    let rim = exp(-(field * field) / (2.0 * (px * 2.2) * (px * 2.2)));
    let rimc = vec3<f32>(1.0) * rim * 0.9;
    var out = vec3<f32>(0.035, 0.04, 0.05) + glowc;
    out = mix(out, col, fill);
    out = out + rimc + col * fill * u.beat * 0.3;
    let vig = 1.0 - dot(in.uv - 0.5, in.uv - 0.5) * 0.5;
    out = out * vig;
    return vec4<f32>(clamp(out, vec3<f32>(0.0), vec3<f32>(1.0)), 1.0);
}
